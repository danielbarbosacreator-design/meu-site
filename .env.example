# Copie para .env.local (desenvolvimento) ou cadastre no Netlify (Site settings → Environment variables).
# Todas são opcionais: sem valor, a página mostra o ponto de integração em vez de inventar conteúdo.

# URL pública final do site, sem barra no final (canonical, Open Graph, sitemap)
VITE_SITE_URL=

# Link do checkout (Hotmart, Kiwify, Stripe Payment Link etc.). Todos os CTAs de compra usam este link.
VITE_CHECKOUT_URL=

# Vídeo principal (home). Use MP4 OU Vimeo.
VITE_HERO_VIDEO_MP4=
VITE_HERO_VIDEO_VIMEO_ID=
VITE_HERO_VIDEO_POSTER=

# Vídeo de demonstração real (seção 07). Use MP4 OU Vimeo.
VITE_DEMO_VIDEO_MP4=
VITE_DEMO_VIDEO_VIMEO_ID=
VITE_DEMO_VIDEO_POSTER=

# Analytics (carregados somente após consentimento do visitante)
VITE_GA4_ID=
VITE_GTM_ID=
VITE_META_PIXEL_ID=

# Contato exibido no rodapé
VITE_CONTACT_EMAIL=
